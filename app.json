{
  "expo": {
    "name": "Beacon Reader MWC01",
    "slug": "beacon-reader-mwc01",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kelvin.beaconreadermwc01",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-manager",
        {
          "isBleRequired": true,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Permitir que o Beacon Reader se conecte aos crachás MWC01 por Bluetooth"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4daecce3-222e-4b57-a71d-5dc95018c3a2"
      }
    }
  }
}
